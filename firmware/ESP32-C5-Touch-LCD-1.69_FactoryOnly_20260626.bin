                remember_bssid: 'Ghi nhб»› BSSID khi kбєїt nб»‘i vб»›i Wi-Fi',
                sleep_mode: 'Bбє­t chбєї Д‘б»™ ngб»§',
                save: 'LЖ°u'
            },
            'zh-CN': {
                title: 'зЅ‘з»њй…ЌзЅ®',
                saved_wifi: 'е·Ідїќе­зљ„ Wi-Fi',
